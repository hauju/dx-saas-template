# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgres://dx_saas:dx_saas@localhost:5432/dx_saas

# =============================================================================
# Application
# =============================================================================
# Public-facing URL of your application. Also serves as the OAuth issuer and
# resource identifier advertised to MCP clients (/.well-known/*), so in
# production this must be the public HTTPS URL.
BASE_URL=http://localhost:8080

# Set to false for local development (no HTTPS)
SECURE_COOKIES=false

# Pre-launch mode: `/` shows a coming-soon page with a waitlist instead of the
# landing page, and the navbar is hidden. Login, docs and the dashboard stay
# reachable at their URLs. Flip to false at launch. The waitlist form uses the
# CAPTCHA_* settings below when they are set.
COMING_SOON=true

# When running behind a reverse proxy, set to true so auth rate limiting
# trusts X-Forwarded-For / X-Real-IP / Forwarded headers.
TRUST_PROXY_HEADERS=false

# Enables the "Dev login (local only)" shortcut that signs in as a fixed local
# user without FerrisKey. Only works in debug builds AND when set to true — the
# whole feature is compiled out of `dx build --release`, so it can never run in
# production. Leave unset/false otherwise.
# DEV_LOGIN=true

# =============================================================================
# Session
# =============================================================================
# 64+ byte hex-encoded secret for signing session cookies
# Generate with: openssl rand -hex 64
SESSION_SECRET=

# =============================================================================
# Encryption (optional)
# =============================================================================
# 32-byte base64-encoded key for AES-256-GCM encryption
# Generate with the crypto crate's generate_key() + encode_key()
# ENCRYPTION_KEY=

# =============================================================================
# FerrisKey (Authentication)
# =============================================================================
# FerrisKey base API URL (e.g. http://localhost:3333 or https://ferriskey.example.com/api)
FERRISKEY_URL=http://localhost:3333
# Optional: FerrisKey public OIDC issuer base URL. Falls back to FERRISKEY_URL
# (with a trailing /api stripped) if unset.
# FERRISKEY_ISSUER_URL=
FERRISKEY_REALM=myapp
FERRISKEY_CLIENT_ID=myapp-dashboard
FERRISKEY_CLIENT_SECRET=

# =============================================================================
# Registration
# =============================================================================
# Who may create an account. A public product opens it. With it unset, only
# the allowlisted addresses/domains may register — or, when both lists are
# empty, only the very first account (first-run bootstrap).
OPEN_REGISTRATION=true
# ALLOWED_REGISTRATION_EMAILS=you@example.com,ops@example.com
# ALLOWED_REGISTRATION_DOMAINS=example.com

# Bollwark captcha in front of new-user registration. All three must be set.
# Without them nothing stands between an open sign-up and account creation,
# so a public deployment should configure it.
# CAPTCHA_URL=https://captcha.example.com
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=

# =============================================================================
# SMTP (Email)
# =============================================================================
# For local dev, use mailpit (localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@example.com
SMTP_USER=
SMTP_PASSWORD=
# Transport security: tls (implicit TLS, port 465), starttls (port 587), or
# none (local dev relays like Mailpit). Defaults to tls, or none when
# SMTP_HOST is a local host.
#SMTP_SECURITY=tls

# =============================================================================
# Polar (Billing) — optional
# =============================================================================
# When POLAR_WEBHOOK_SECRET is set, POST /webhooks/polar verifies the Standard
# Webhooks signature and syncs subscription state onto the user. Checkout must
# set the subscription metadata.reference_id to the user id.
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=

# =============================================================================
# Sentry (Error tracking) — optional, requires --features sentry
# =============================================================================
# SENTRY_DSN=
# ENVIRONMENT=development
