# =============================================================================
# Database
# =============================================================================
DATABASE_URL=mongodb://localhost:27017/?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# =============================================================================
# Application
# =============================================================================
# Public-facing URL of your application
BASE_URL=http://localhost:8080

# Set to false for local development (no HTTPS)
SECURE_COOKIES=false

# When running behind a reverse proxy, set to true so auth rate limiting
# trusts X-Forwarded-For / X-Real-IP / Forwarded headers.
TRUST_PROXY_HEADERS=false

# =============================================================================
# Session
# =============================================================================
# 64+ byte hex-encoded secret for signing session cookies
# Generate with: openssl rand -hex 64
SESSION_SECRET=

# =============================================================================
# Encryption (optional)
# =============================================================================
# 32-byte base64-encoded key for AES-256-GCM encryption
# Generate with the crypto crate's generate_key() + encode_key()
# ENCRYPTION_KEY=

# =============================================================================
# FerrisKey (Authentication)
# =============================================================================
# FerrisKey base API URL (e.g. http://localhost:3333 or https://ferriskey.example.com/api)
FERRISKEY_URL=http://localhost:3333
# Optional: FerrisKey public OIDC issuer base URL. Falls back to FERRISKEY_URL
# (with a trailing /api stripped) if unset.
# FERRISKEY_ISSUER_URL=
FERRISKEY_REALM=myapp
FERRISKEY_CLIENT_ID=myapp-dashboard
FERRISKEY_CLIENT_SECRET=

# =============================================================================
# SMTP (Email)
# =============================================================================
# For local dev, use mailpit (localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@example.com
SMTP_USER=
SMTP_PASSWORD=

# =============================================================================
# Polar (Billing) — optional
# =============================================================================
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=

# =============================================================================
# Sentry (Error tracking) — optional, requires --features sentry
# =============================================================================
# SENTRY_DSN=
# ENVIRONMENT=development
